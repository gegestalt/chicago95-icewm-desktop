# Chicago OS Start menu (jgmenu), Windows XP Luna style.
# Pixel sizes and font sizes here are for a 1x screen at TEXT_SCALE 1;
# chicago-display-adapt writes the scaled ~/.config/jgmenu/jgmenurc.
# Contents: ~/.local/bin/chicago-start-menu (+ start-pinned.csv,
# start-footer.csv in this folder).
csv_cmd = ~/.local/bin/chicago-start-menu
csv_no_duplicates = 0
stay_alive = 0
tint2_look = 0
hover_delay = 80

# Opens from the Start button, just above the dock.
position_mode = fixed
menu_halign = left
menu_valign = bottom
menu_margin_x = 2
menu_margin_y = 40
menu_width = 290
menu_padding_top = 4
menu_padding_right = 4
menu_padding_bottom = 6
menu_padding_left = 4
menu_radius = 8
menu_border = 2
sub_spacing = 2

item_margin_x = 2
item_margin_y = 1
item_height = 38
item_padding_x = 10
item_radius = 4
item_border = 1
sep_height = 9
icon_size = 32
icon_text_spacing = 12
arrow_width = 16
arrow_string = ▸

font = Ubuntu Sans 12
icon_theme = Chicago95-tux
icon_theme_fallback = hicolor

# XP Luna: white body fading to pale blue, blue frame and highlight.
color_menu_bg = #FFFFFF 100
color_menu_bg_to = #D3E0F7 100
menu_gradient_pos = bottom
color_menu_border = #245EDC 100
color_norm_bg = #000000 0
color_norm_fg = #1B1B1B 100
color_sel_bg = #316AC5 100
color_sel_fg = #FFFFFF 100
color_sel_border = #1C4FA8 100
color_sep_fg = #B7C6E2 100
color_title_bg = #2457C8 100
color_title_fg = #FFFFFF 100
color_title_border = #1C46A8 100
color_scroll_ind = #245EDC 100
