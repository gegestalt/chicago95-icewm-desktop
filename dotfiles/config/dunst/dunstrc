[global]
font = Ubuntu Sans 10
origin = top-right
offset = 12x12
width = 350
frame_width = 1
frame_color = "#808080"
separator_height = 1
separator_color = frame
corner_radius = 10
gap_size = 6
icon_corner_radius = 4
min_icon_size = 24
max_icon_size = 40
format = "<b>%s</b>\n%b"
padding = 10
horizontal_padding = 12

[urgency_low]
background = "#D4D0C8"
foreground = "#202630"

[urgency_normal]
background = "#D4D0C8"
foreground = "#202630"

[urgency_critical]
background = "#D4D0C8"
foreground = "#202630"
frame_color = "#FF605C"
