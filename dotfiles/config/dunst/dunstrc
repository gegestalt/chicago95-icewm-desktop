[global]
font = Adwaita Sans 10
origin = top-right
offset = 10x10
width = 350
frame_width = 2
frame_color = "#000000"
separator_height = 2
separator_color = frame
corner_radius = 0
padding = 8
horizontal_padding = 8

[urgency_low]
background = "#c0c0c0"
foreground = "#000000"

[urgency_normal]
background = "#c0c0c0"
foreground = "#000000"

[urgency_critical]
background = "#c0c0c0"
foreground = "#000000"
frame_color = "#800000"
