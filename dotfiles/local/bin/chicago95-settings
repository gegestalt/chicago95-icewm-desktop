#!/bin/bash
# ~/.local/bin/chicago95-settings — the taskbar/app-grid "Settings" entry.
#
# A yad picker fronting a small, themable, GTK3 tool per category instead
# of GNOME Control Center's own panels (fixes #29). Two problems with the
# GNOME panels drove this:
#
# 1. Function: several panels depend on daemons a plain IceWM session
#    doesn't run. Display needs org.gnome.Mutter.DisplayConfig (Mutter/
#    GNOME Shell only — confirmed via its own stderr: "Error calling
#    GetCurrentState: GDBus.Error:...NameHasNoOwner: Name
#    'org.gnome.Mutter.DisplayConfig' does not exist"). Power similarly
#    needs its own daemon running (xfce4-power-manager-settings itself
#    prompts "Xfce4 Power Manager is not running" until it is — see the
#    startup dotfile, which now starts it). Every control in an affected
#    panel opens fine but silently does nothing.
# 2. Design consistency: GNOME Control Center is GTK4/libadwaita, which
#    cannot be reskinned to match Chicago95 at all (see the README's
#    "What it doesn't do") — even the panels that DO work look like a
#    modern GNOME popup dropped into a Windows-95 desktop.
#
# Users and Date/Time are the two exceptions still routed to GNOME
# Control Center: no themable GTK3 equivalent ships in Ubuntu's repos for
# either, and both actually work under IceWM regardless, because their
# backends (accountsservice and systemd-timedated respectively) are
# standalone D-Bus services with no Mutter/gsd dependency — verified by
# checking what each panel actually talks to, not just that it opens.
#
# No literal "&" in any row label below: yad's --list renders each cell as
# Pango markup, and a bare "&" is invalid markup — it doesn't error, it
# just silently breaks that row (observed: the label rendered as a repeat
# of the row above's label instead of its own text). Spelled out "and"
# instead, matching the rest of the copy in this list anyway.
export GTK_THEME=Chicago95
export GTK_ICON_THEME=Chicago95-tux

CHOICE="$(
	yad \
		--title="Control Panel" \
		--window-icon=preferences-system \
		--width=700 \
		--height=520 \
		--center \
		--list \
		--no-headers \
		--column="Setting" \
		--column="Description" \
		"Display" "Resolution, scaling and monitors" \
		"Network" "Wi-Fi, Ethernet and connections" \
		"Bluetooth" "Bluetooth devices" \
		"Sound" "Input, output and volume" \
		"Power" "Power and battery settings" \
		"Keyboard" "Keyboard options and shortcuts" \
		"Mouse and Touchpad" "Mouse and pointing-device settings" \
		"Appearance" "Theme, icons and fonts" \
		"Users" "User accounts" \
		"Date and Time" "Clock and timezone" \
		"System" "System information and details" \
		--button="Open:0" \
		--button="Cancel:1"
)" || exit 0

NAME="$(printf '%s' "$CHOICE" | cut -d'|' -f1)"

case "$NAME" in
	"Display")
		arandr
		;;
	"Network")
		nm-connection-editor
		;;
	"Bluetooth")
		blueman-manager
		;;
	"Sound")
		pavucontrol
		;;
	"Power")
		xfce4-power-manager-settings
		;;
	"Keyboard")
		xfce4-keyboard-settings
		;;
	"Mouse and Touchpad")
		xfce4-mouse-settings
		;;
	"Appearance")
		xfce4-appearance-settings
		;;
	"Users")
		XDG_CURRENT_DESKTOP=ubuntu:GNOME gnome-control-center user-accounts
		;;
	"Date and Time")
		XDG_CURRENT_DESKTOP=ubuntu:GNOME gnome-control-center datetime
		;;
	"System")
		hardinfo2
		;;
esac
