#!/bin/sh
# Works around a pcmanfm --desktop bug: dragging a desktop icon to a new
# spot saves its new position correctly, but the icon isn't repainted
# anywhere (not at the old spot, not at the new one) until some unrelated
# screen event forces a redraw — see issue #19. Root cause: pcmanfm's
# desktop is one single window (confirmed via `xwininfo -root -tree`), not
# one window per icon, so this is a GTK-internal draw-invalidation bug
# inside pcmanfm itself; neither a compositor nor `xrefresh` (both tested)
# can paper over it from outside.
#
# When pcmanfm saves the layout file after a drag, this clicks once to make
# pcmanfm repaint. Safety rules (an earlier version clicked a fixed screen
# spot, which could land on the dock or close an open menu):
#   - only when the pointer is over the desktop itself (an icon was just
#     dropped there), never over a window, menu or the dock;
#   - the click goes where the pointer already is: on the icon that was
#     just dropped, which is selected after a drop anyway;
#   - event-driven with inotifywait when available (no busy polling).
CONF_DIR="$HOME/.config/pcmanfm/icewm"
CONF="$CONF_DIR/desktop-items-0.conf"

pointer_on_desktop() {
  eval "$(xdotool getmouselocation --shell 2>/dev/null)" || return 1
  [ -n "${WINDOW:-}" ] || return 1
  xprop -id "$WINDOW" _NET_WM_WINDOW_TYPE 2>/dev/null | grep -q _NET_WM_WINDOW_TYPE_DESKTOP
}

repaint() {
  # Let the drop finish (button released) before clicking.
  sleep 0.15
  pointer_on_desktop && xdotool click 1
}

mkdir -p "$CONF_DIR"
if command -v inotifywait >/dev/null 2>&1; then
  # Watch the directory: pcmanfm replaces the file on save.
  inotifywait -m -q -e close_write,moved_to --format '%f' "$CONF_DIR" 2>/dev/null |
  while read -r name; do
    [ "$name" = "desktop-items-0.conf" ] && repaint
  done
else
  LAST="$(stat -c %Y "$CONF" 2>/dev/null)"
  while sleep 0.3; do
    CUR="$(stat -c %Y "$CONF" 2>/dev/null)"
    if [ -n "$CUR" ] && [ "$CUR" != "$LAST" ]; then
      LAST="$CUR"; repaint
    fi
  done
fi
