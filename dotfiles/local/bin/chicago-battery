#!/bin/sh
# chicago-battery — the Mac's battery for the dock (tint2 executor).
# Fusion doesn't give ARM Linux guests a virtual battery, so the Mac
# publishes it instead: host/macos/install-battery-feed.sh runs a launchd
# job that writes "percent state unix-time" to the VM's guestinfo once a
# minute. Prints nothing (dock item hidden) when there is no fresh value,
# e.g. the feed isn't installed or the Mac was asleep.
v=$(vmware-rpctool "info-get guestinfo.battery" 2>/dev/null) || exit 0
# shellcheck disable=SC2086  # split "percent state time" into $1 $2 $3
set -- $v
pct=${1:-}; state=${2:-}; ts=${3:-0}
case "$pct" in ''|*[!0-9]*) exit 0 ;; esac
[ $(( $(date +%s) - ts )) -gt 300 ] && exit 0

# One low-battery warning per discharge.
flag="${XDG_RUNTIME_DIR:-/tmp}/chicago-battery-warned"
if [ "$state" = discharging ] && [ "$pct" -le 10 ]; then
  [ -e "$flag" ] || { notify-send -u critical "Battery low ($pct%)" "Plug in your Mac"; : > "$flag"; }
else
  rm -f "$flag"
fi

case "$state" in
  charging|finishing*|charged|AC*) echo "⚡ $pct%" ;;
  *) echo "$pct%" ;;
esac
