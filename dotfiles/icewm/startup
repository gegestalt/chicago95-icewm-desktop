#!/bin/sh

export GTK_THEME=Chicago95

# Fixes #28 ("screen not fullsize"): on some setups (observed on a VMware
# guest) the X server comes up with a connected output already running a
# mode other than its own preferred one — e.g. locked to whatever size was
# negotiated at an earlier boot — leaving a visible gap of unused screen
# instead of filling the real display. For each connected output, if its
# current mode isn't the one xrandr itself marks preferred (the "+" in
# `xrandr --query`), switch to that preferred mode. A no-op on ordinary
# hardware, which is already running its preferred mode.
if command -v xrandr >/dev/null 2>&1; then
  xrandr --query | awk '/ connected /{print $1}' | while read -r output; do
    preferred=$(xrandr --query | awk -v out="$output" '
      $0 ~ "^"out" connected" {grab=1; next}
      grab && /^[A-Za-z]/ {grab=0}
      grab && / \+/ {print $1; exit}
    ')
    [ -n "$preferred" ] && xrandr --output "$output" --mode "$preferred"
  done
fi

# Make both Windows/Super keys work as an extra Alt too, so Super+Tab
# does window-switching (KeySysSwitchNext="Alt+Tab") on compact/60%
# keyboards where Alt and Win sit right next to each other. Additive —
# appended to whatever XKB options are already active (e.g. from
# /etc/default/keyboard) rather than replacing them.
command -v setxkbmap >/dev/null 2>&1 && setxkbmap -option "altwin:alt_win"

# En/Tr keyboard-layout indicator and switcher, bottom-right of the
# taskbar (IceWM's system tray). Click it to pick a layout from a menu
# (the active one shown selected) rather than just toggling — see
# keyboard-layout-picker itself for why this isn't xxkb.
command -v python3 >/dev/null 2>&1 && "$HOME/.local/bin/keyboard-layout-picker" &

# XSETTINGS provider for GTK apps (icon theme, font, DPI, cursor). IceWM
# doesn't run one itself, and without it GTK falls back to raw toolkit
# defaults (Adwaita icons, unthemed fonts) until something else happens to
# start one. Started first so pcmanfm/nm-applet/dunst below pick it up from
# their very first frame instead of a fresh login briefly looking wrong.
xfsettingsd &

# Floating dock (Start, pinned apps, open windows, tray, clock). When tint2
# is installed, chicago-display-adapt hides IceWM's own edge-to-edge
# taskbar (ShowTaskBar=0); without tint2, IceWM's taskbar stays as before.
command -v tint2 >/dev/null 2>&1 && { pgrep -u "$USER" -x tint2 >/dev/null || tint2 & }

# Power-management daemon backing the Control Panel's "Power" entry
# (xfce4-power-manager-settings) — without it running, that settings
# dialog just prompts "Xfce4 Power Manager is not running" instead of
# showing any controls (fixes #29).
command -v xfce4-power-manager >/dev/null 2>&1 && xfce4-power-manager &

# Keep the flat "Applications" grid (~/Applications) in sync with installed apps.
"$HOME/.local/bin/build-app-grid" &

# Desktop icons / file manager.
pcmanfm --desktop --profile=icewm &

# Works around a pcmanfm bug (issue #19): a dragged desktop icon doesn't
# get repainted until some unrelated screen event forces it to. See the
# script itself for the full story.
command -v xdotool >/dev/null 2>&1 && "$HOME/.local/bin/desktop-icon-repaint-watch" &

# Notifications.
dunst &

# Network tray.
nm-applet &

# VMware host/guest clipboard and drag/drop (no-op outside a VMware VM).
[ -x /usr/bin/vmware-user ] && /usr/bin/vmware-user >/tmp/vmware-user.log 2>&1 &

# Compositor (window shadows, rounded window corners): OFF by default.
# Without GPU acceleration (VMware: "Accelerate 3D graphics" off, renderer
# llvmpipe) picom either repaints only damaged areas, which on vmwgfx left
# stale patches and blank menus, or repaints everything, which costs a CPU
# core. Everything draws correctly without it. To turn it on, set
# COMPOSITOR=1 in ~/.config/chicago-os/display.conf and log in again.
if grep -qs '^COMPOSITOR=1' "$HOME/.config/chicago-os/display.conf" && command -v picom >/dev/null 2>&1; then
  pgrep -u "$USER" -x picom >/dev/null || picom --config "$HOME/.config/picom/picom.conf" -b
fi

# Keeps fonts, window chrome, icons and cursor at the right size for the
# current resolution and re-applies on every resize of the VM window.
# Settings: ~/.config/chicago-os/display.conf
command -v xev >/dev/null 2>&1 && "$HOME/.local/bin/chicago-display-adapt" &

exit 0
