#!/bin/sh

export GTK_THEME=Chicago95

# XSETTINGS provider for GTK apps (icon theme, font, DPI, cursor). IceWM
# doesn't run one itself, and without it GTK falls back to raw toolkit
# defaults (Adwaita icons, unthemed fonts) until something else happens to
# start one. Started first so pcmanfm/nm-applet/dunst below pick it up from
# their very first frame instead of a fresh login briefly looking wrong.
xfsettingsd &

# Compositor. IceWM has no compositing of its own, and without one
# pcmanfm's desktop icons have a reproducible bug: dragging one to a new
# spot moves its stored position correctly but doesn't repaint it anywhere
# until some unrelated Expose event happens (e.g. clicking empty desktop) —
# see issue #19. picom forces that repaint to actually happen.
command -v picom >/dev/null 2>&1 && picom -b

# Keep the flat "Applications" grid (~/Applications) in sync with installed apps.
"$HOME/.local/bin/build-app-grid" &

# Desktop icons / file manager.
pcmanfm --desktop --profile=icewm &

# Notifications.
dunst &

# Network tray.
nm-applet &

# VMware host/guest clipboard and drag/drop (no-op outside a VMware VM).
[ -x /usr/bin/vmware-user ] && /usr/bin/vmware-user >/tmp/vmware-user.log 2>&1 &

exit 0
