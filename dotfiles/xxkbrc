! ~/.xxkbrc — English/Turkish layout indicator and switcher, lives in the
! IceWM system tray (bottom-right taskbar). Click it to toggle between the
! two layouts setxkbmap loads in .icewm/startup ("us,tr" — group 1 is
! English, group 2 is Turkish).
!
! Squared off at 32x32 (matching the tray's TrayIconMaxWidth/Height, so
! it's the same size as the ibus/nm-applet icons beside it rather than a
! near-invisible sliver), all-caps "EN"/"TR" labels, and the same light
! blue/turquoise label color (#51A2DA) ibus's own tray icon uses — kept on
! a black square so it's still legible as a distinct button rather than
! blending into the gray tray background. ibus's own tray icon is hidden
! (see install.sh's show-icon-on-systray dconf write) so this is the only
! layout indicator in the tray, and the only one that's actually
! clickable — ibus's tray icon doesn't support click-to-switch, only this
! one does.
!
! Turkish here is the standard XKB "tr" (Q) layout, not an Apple-style
! "Turkish Mac" layout — X11's xkeyboard-config ships no such variant
! (checked directly against /usr/share/X11/xkb/rules/evdev.xml: the real
! tr variants are f/e/alt/intl, none of them "mac"). This is the closest
! available match for everyday typing. Swap XXkb.group.alt/base or run
! `setxkbmap -layout tr -variant intl` by hand to try the dead-key
! "international" variant instead, if the base Q layout doesn't fit.

XXkb.mainwindow.enable: yes
XXkb.mainwindow.appicon: no
XXkb.mainwindow.type: tray
XXkb.mainwindow.border.width: 0
XXkb.mainwindow.geometry: 32x32+0+0

XXkb.mainwindow.label.enable: yes
XXkb.mainwindow.label.text.1: EN
XXkb.mainwindow.label.text.2: TR
XXkb.mainwindow.label.font: -misc-*-bold-r-*-15-*
XXkb.mainwindow.label.background: #000000
XXkb.mainwindow.label.foreground: #51A2DA

XXkb.group.base: 1
XXkb.group.alt: 2
XXkb.controls.two_state: yes
XXkb.controls.focusout: no
XXkb.controls.add_when_start: yes
XXkb.controls.add_when_create: yes
XXkb.controls.add_when_change: no

XXkb.button.enable: no
XXkb.bell.enable: no
